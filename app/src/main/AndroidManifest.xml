<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the connection is metered (mobile data): the lower max quality there. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
    Media3 asks for this for ExoPlayer's wake mode (keeping the CPU awake while playing with
    the screen off). The app never turns that on: the screen stays on while a video plays,
    and leaving the app pauses it. (.github/scripts/apk-security.py checks the permissions.)
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!--
    Watch history and subscriptions stay on the phone, not in a Google Drive backup:
    dataExtractionRules on Android 12+ (device-to-device transfer to a new phone still
    works), allowBackup="false" before that (so no fullBackupContent is needed).
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Antenna"
        android:supportsRtl="true">

        <!--
        The app's only screen; the player is drawn over the tabs. It also opens YouTube video
        links shared from or opened in other apps. singleTask: a link plays in the app that's
        already open (Back returns to the video that was playing) instead of starting a second
        copy with a second player. The config changes are handled by the screen itself, so
        rotating, resizing or switching dark mode doesn't interrupt the video.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Video links only: channels and playlists are left to the YouTube app or the browser.
                 Not App Links (autoVerify): youtube.com can't be verified for this app. -->
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
                <data android:pathPrefix="/embed/" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkWarning">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>
        </activity>
    </application>
</manifest>
