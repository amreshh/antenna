<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: watch history and subscriptions stay out of Google Drive backups. Moving to
     a new phone with device-to-device transfer (no rules here) still brings everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
