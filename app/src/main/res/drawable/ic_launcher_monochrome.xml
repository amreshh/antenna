<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's monochrome layer, for themed icons (Android 13+): the TV from
     ic_launcher_foreground.xml as one shape, which the launcher colours. The screen, the
     knobs and the speaker grille are holes in the TV (evenOdd), the play button sits in the
     screen, and the antennas and signal arcs are lines. Same canvas and safe zone as the
     foreground; keep the two in step. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="400"
    android:viewportHeight="400">
    <group
        android:scaleX="0.76"
        android:scaleY="0.76"
        android:translateX="48.0"
        android:translateY="59.4">
        <!-- signal -->
        <path
            android:pathData="M 182 88 A 26 26 0 0 1 218 88"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 166 70 A 46 46 0 0 1 234 70"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <!-- antennas, their tips, and the base they stand on -->
        <path
            android:pathData="M188,122 L128,62 M212,122 L272,62"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M116,62 A12,12 0 1 0 140,62 A12,12 0 1 0 116,62 Z M260,62 A12,12 0 1 0 284,62 A12,12 0 1 0 260,62 Z M 172 135 A 28 24 0 0 1 228 135 Z"
            android:fillColor="#FFFFFFFF" />
        <!-- legs -->
        <path
            android:pathData="M112,296 L100,314 M286,296 L298,314"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <!-- the TV, with the screen, knobs and grille cut out -->
        <path
            android:fillType="evenOdd"
            android:pathData="M102,135 H294 A30,30 0 0 1 324,165 V267 A30,30 0 0 1 294,297 H102 A30,30 0 0 1 72,267 V165 A30,30 0 0 1 102,135 Z M114,155 H236 A22,22 0 0 1 258,177 V255 A22,22 0 0 1 236,277 H114 A22,22 0 0 1 92,255 V177 A22,22 0 0 1 114,155 Z M276,182 A14,14 0 1 0 304,182 A14,14 0 1 0 276,182 Z M276,220 A14,14 0 1 0 304,220 A14,14 0 1 0 276,220 Z M276.5,247.5 H303.5 A2.5,2.5 0 0 1 303.5,252.5 H276.5 A2.5,2.5 0 0 1 276.5,247.5 Z M276.5,257.5 H303.5 A2.5,2.5 0 0 1 303.5,262.5 H276.5 A2.5,2.5 0 0 1 276.5,257.5 Z M276.5,267.5 H303.5 A2.5,2.5 0 0 1 303.5,272.5 H276.5 A2.5,2.5 0 0 1 276.5,267.5 Z"
            android:fillColor="#FFFFFFFF" />
        <!-- play button -->
        <path
            android:pathData="M 160 192 L 202 216 L 160 240 Z"
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />
    </group>
</vector>
